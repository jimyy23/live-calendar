BASE_URL=https://example.com/
ADMIN_PASSWORD=admin9189051309changeme
TEAM_PING_TOKEN=team934893085492changeme
TIMEZONE=America/Toronto

# Working-block sync driven by the Windows client (true/false, default true)
# SYNC_FILL_ONLINE: create/extend "Working" blocks while the user is online
# SYNC_EAT_OFFLINE: trim/delete "Working" blocks while the user is offline
SYNC_FILL_ONLINE=true
SYNC_EAT_OFFLINE=true

# Optional comma-separated ASN allowlist. Empty = unrestricted.
# Example: ALLOWED_ASNS=AS13335,15169
ALLOWED_ASNS=
# Only explicitly trusted reverse proxies may supply X-Forwarded-For.
# Set to your actual Easypanel/Traefik proxy IPs or dedicated proxy subnet.
# Do NOT trust 0.0.0.0/0 or ::/0. Leave empty for direct connections.
TRUSTED_PROXY_CIDRS=
